# Every variable used by any example in this repo.
# Copy to .env (never commit it). Each example also has its own .env.example with only what it needs.

# --- Opik ---------------------------------------------------------------
# API key: https://www.comet.com/opik/ -> your avatar -> API key
OPIK_API_KEY=
# Your Opik workspace name (shown in the Opik URL). voltagent-restaurant-reservations also accepts OPIK_WORKSPACE_NAME.
OPIK_WORKSPACE=
# Opik Cloud REST base URL. For self-hosted Opik use e.g. http://localhost:5173/api
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
# Optional: OTLP endpoint for the OTel-based examples (Java, Temporal, smolagents, Pydantic AI, VoltAgent, BeeAI).
# Default is Opik Cloud. For self-hosted: http://localhost:5173/api/v1/private/otel
# OPIK_OTEL_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# Optional: each example already logs to a project named after its folder; set this only to override it.
# OPIK_PROJECT_NAME=

# --- LLM providers ----------------------------------------------------------
# OpenAI key, used by most examples: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic key, used by anthropic-museum-guide-citations and litellm-changelog-router: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# --- Local services -----------------------------------------------------
# ollama-langchainjs-homebrew-rag: the Ollama container this example starts on host port 11535
# OLLAMA_URL=http://localhost:11535
# HTTP port: quarkus-langchain4j-banking-faq (default 4261) and langchainjs-fastify-bike-shop
# (server default 4200; its demo starts its own server on 4201). Set it only to override a default.
# PORT=
