# Opik API key (https://www.comet.com/opik -> profile -> API keys).
# There is deliberately no OPENAI_API_KEY or any other provider key: both
# models run locally in Ollama.
OPIK_API_KEY=

# Opik workspace the traces are sent to
OPIK_WORKSPACE=

# Opik Cloud endpoint. Remove this line when you self-host Opik (default http://localhost:5173/api),
# which keeps even the traces on your own machine.
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api

# Optional: where Ollama listens (default matches docker-compose.yml)
# OLLAMA_URL=http://localhost:11535
