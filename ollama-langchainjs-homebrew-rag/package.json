{
  "name": "ollama-langchainjs-homebrew-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fully local RAG over a fictional homebrewing handbook: LangChain.js + Ollama in Docker, traced with opik-langchain. Zero cloud LLM calls.",
  "scripts": {
    "setup": "tsx src/setup.ts",
    "demo": "tsx src/demo.ts",
    "stop": "docker compose down",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/classic": "^1.0.52",
    "@langchain/core": "^1.2.17",
    "@langchain/ollama": "^1.3.0",
    "dotenv": "^17.2.0",
    "opik": "2.2.96",
    "opik-langchain": "2.2.96"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
