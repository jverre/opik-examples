# Keys the setup script needs. Export them in your shell, or copy this file
# to .env (setup.sh loads it). Never commit the real .env.

# OpenAI: Dify stores this as its model-provider credential (gpt-4o-mini).
OPENAI_API_KEY=

# Opik: where Dify sends the traces. If these are unset, setup.sh falls back
# to ~/.opik.config (written by `opik configure`).
OPIK_API_KEY=your-opik-api-key
OPIK_WORKSPACE=your-workspace-name
# Opik Cloud is the default. For self-hosted Opik, set the API URL, e.g.
# http://host.docker.internal:5173/api/ (Dify runs inside Docker).
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api/

# Optional overrides (defaults shown).
# DIFY_PORT=4290
# DIFY_SSL_PORT=4291
# DIFY_ADMIN_EMAIL=admin@larkspur.example
# DIFY_ADMIN_PASSWORD=LarkspurHousing2026
