# Opik API key: the n8n container exports OpenTelemetry spans to Opik with it
# (https://www.comet.com/opik -> profile -> API keys)
OPIK_API_KEY=

# Opik workspace the traces are sent to
OPIK_WORKSPACE=

# Only for self-hosted Opik. Leave unset for Opik Cloud.
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api

# OpenAI key: setup.sh turns it into an n8n credential at runtime.
# It is never written into the committed workflow file.
OPENAI_API_KEY=
