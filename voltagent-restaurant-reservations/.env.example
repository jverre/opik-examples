# OpenAI: the assistant runs on gpt-4o-mini
OPENAI_API_KEY=

# Opik Cloud: get a key at https://www.comet.com/opik (Settings -> API Keys)
OPIK_API_KEY=
# Your Opik workspace name (shown in the top-left of the Opik UI)
OPIK_WORKSPACE_NAME=

# Optional: Opik project to log to (defaults to voltagent-restaurant-reservations)
# OPIK_PROJECT_NAME=voltagent-restaurant-reservations
# Optional: self-hosted or enterprise Opik (e.g. http://localhost:5173/api)
# OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
