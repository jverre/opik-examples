# OpenAI API key: gpt-4o-mini classifies the messages AND acts as the
# optimizer's reasoning model, so this one key covers the whole run.
OPENAI_API_KEY=

# Opik credentials: the optimization run, both datasets, trial experiments and
# prompt library versions are written to this workspace.
# Get them from https://www.comet.com/opik (or run `opik configure`).
OPIK_API_KEY=...
OPIK_WORKSPACE=...
