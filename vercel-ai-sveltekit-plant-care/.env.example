# OpenAI API key: gpt-4o-mini answers the chat and judges it (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Opik API key: comet.com -> your avatar -> API Keys (https://www.comet.com/opik)
OPIK_API_KEY=your-opik-api-key

# Opik workspace: your workspace name on Opik Cloud
OPIK_WORKSPACE=your-workspace

# Opik endpoint: keep this value for Opik Cloud; change it for self-hosted
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
