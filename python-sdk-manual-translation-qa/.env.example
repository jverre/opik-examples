# OpenAI key: every LLM step (detect, translate, back-translate, judge) runs on gpt-4o-mini
OPENAI_API_KEY=
# Opik credentials. Not needed if you already ran `opik configure` (writes ~/.opik.config).
OPIK_API_KEY=
OPIK_WORKSPACE=
# Self-hosted Opik only (default is Opik Cloud): OPIK_URL_OVERRIDE=http://localhost:5173/api
