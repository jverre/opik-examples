    "dotenv": "^17.2.0",
    "fastify": "^5.12.5",
    "opik": "2.2.96",
    "opik-langchain": "2.2.96"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
