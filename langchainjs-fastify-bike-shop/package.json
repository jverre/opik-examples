{
  "name": "langchainjs-fastify-bike-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Website chat for a fictional bike repair shop: LangChain.js + Fastify, traced with opik-langchain so every visitor session is one clean Opik thread.",
