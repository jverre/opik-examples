# OpenAI API key used by the shop assistant (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# Opik API key (https://www.comet.com/opik -> profile -> API keys)
OPIK_API_KEY=

# Opik workspace the traces are sent to
OPIK_WORKSPACE=

# Opik Cloud endpoint. Remove this line when you self-host Opik (default http://localhost:5173/api).
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api
